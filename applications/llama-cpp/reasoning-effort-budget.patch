+static int rocmplete_reasoning_effort_budget(const std::string & effort) {
+    if (effort == "none") {
+        return 0;
+    }
+    if (effort == "low") {
+        return 1024;
+    }
+    if (effort == "medium") {
+        return 4096;
+    }
+    if (effort == "high") {
+        return 8192;
+    }
+    return -1;
+}
