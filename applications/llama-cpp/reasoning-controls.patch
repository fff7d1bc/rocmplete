+static std::string parse_sampling_defaults_by_reasoning(const std::string & value) {
+    const auto config = json::parse(value);
+    if (!config.is_object() || config.size() != 2 ||
+        !config.contains("thinking") || !config.contains("non_thinking")) {
+        throw std::invalid_argument(
+            "sampling defaults must contain exactly thinking and non_thinking objects");
+    }
+
+    static const std::set<std::string> fields = {
+        "temperature", "top_p", "top_k", "min_p",
+        "presence_penalty", "repeat_penalty",
+    };
+    for (const char * mode : {"thinking", "non_thinking"}) {
+        const auto & defaults = config.at(mode);
+        if (!defaults.is_object() || defaults.empty()) {
+            throw std::invalid_argument(
+                string_format("sampling defaults mode '%s' must be a non-empty object", mode));
+        }
+        for (const auto & item : defaults.items()) {
+            if (fields.find(item.key()) == fields.end()) {
+                throw std::invalid_argument(
+                    string_format("unsupported sampling default '%s'", item.key().c_str()));
+            }
+            const auto & candidate = item.value();
+            if (item.key() == "top_k") {
+                if (!candidate.is_number_integer() ||
+                    candidate.get<double>() < 0.0 || candidate.get<double>() > INT_MAX) {
+                    throw std::invalid_argument("top_k sampling default must be a non-negative integer");
+                }
+                continue;
+            }
+            if (!candidate.is_number()) {
+                throw std::invalid_argument(
+                    string_format("sampling default '%s' must be numeric", item.key().c_str()));
+            }
+            const double number = candidate.get<double>();
+            if (!std::isfinite(number) ||
+                (item.key() == "temperature" && number < 0.0) ||
+                ((item.key() == "top_p" || item.key() == "min_p") &&
+                 (number < 0.0 || number > 1.0)) ||
+                (item.key() == "repeat_penalty" && number <= 0.0)) {
+                throw std::invalid_argument(
+                    string_format("invalid sampling default '%s'", item.key().c_str()));
+            }
+        }
+    }
+    return config.dump();
+}
