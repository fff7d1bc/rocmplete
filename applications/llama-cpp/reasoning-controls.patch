 #include <cstring>
 #include <type_traits>
 
+// Maki 0.4.8's llama.cpp transport converts its named selectors to these
+// exact budgets for ROCmplete's advertised 16384-token output window. Recover
+// the name for templates with native effort/strength controls while retaining
+// the numeric sampler ceiling Maki requested.
+static std::string rocmplete_maki_reasoning_level(int budget) {
+    if (budget == 1638 || budget == 3276) {
+        return "low";
+    }
+    if (budget == 6553) {
+        return "medium";
+    }
+    if (budget == 9830) {
+        return "high";
+    }
+    if (budget == 13107 || budget == 16384) {
+        return "xhigh";
+    }
+    return "";
+}
+
+// Apply data supplied by the model preset only as defaults. This keeps the
+// template responsible for resolving thinking mode without giving Jinja a
+// side channel into sampler state, and explicit request fields remain final.
+static void rocmplete_apply_sampling_defaults(
+        json & llama_params,
+        const json & body,
+        const json & defaults_by_reasoning,
+        bool enable_thinking) {
+    if (defaults_by_reasoning.empty()) {
+        return;
+    }
+    const auto & defaults = defaults_by_reasoning.at(
+        enable_thinking ? "thinking" : "non_thinking");
+    for (const auto & item : defaults.items()) {
+        const auto it = body.find(item.key());
+        if (it == body.end() || it->is_null()) {
+            llama_params[item.key()] = item.value();
+        }
+    }
+}
