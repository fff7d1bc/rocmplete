 #include <cstring>
 #include <type_traits>
 
+// Maki 0.4.5's llama.cpp transport converts its named selectors to these
+// exact budgets for ROCmplete's advertised 16384-token output window. Recover
+// the name for templates with native effort/strength controls while retaining
+// the numeric sampler ceiling Maki requested.
+static std::string rocmplete_maki_reasoning_level(int budget) {
+    if (budget == 1638 || budget == 3276) {
+        return "low";
+    }
+    if (budget == 6553) {
+        return "medium";
+    }
+    if (budget == 9830) {
+        return "high";
+    }
+    if (budget == 13107 || budget == 16384) {
+        return "xhigh";
+    }
+    return "";
+}
+
+static bool rocmplete_native_reasoning_level(const std::string & level) {
+    return level == "low" || level == "medium" ||
+           level == "high" || level == "xhigh";
+}
+
 json format_error_response(const std::string & message, const enum error_type type) {
     std::string type_str;
