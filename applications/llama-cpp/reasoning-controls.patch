+    // Maki transports its named selectors as numeric budgets. Preserve that
+    // sampler ceiling while supplying one native label for the template caps
+    // layer to alias to either Qwen effort or Muse strength. Explicit native
+    // template kwargs win over this compatibility recovery.
+    const auto has_native_reasoning_level = [&inputs]() {
+        return inputs.chat_template_kwargs.find("reasoning_effort") !=
+                   inputs.chat_template_kwargs.end() ||
+               inputs.chat_template_kwargs.find("reasoning_strength") !=
+                   inputs.chat_template_kwargs.end();
+    };
+    if (!body.contains("reasoning_effort") &&
+        body.contains("thinking_budget_tokens")) {
+        const int thinking_budget = json_value(body, "thinking_budget_tokens", -1);
+        if (thinking_budget == 0) {
+            inputs.enable_thinking = false;
+        } else if (thinking_budget > 0 && !has_native_reasoning_level()) {
+            const auto reasoning_level = rocmplete_maki_reasoning_level(thinking_budget);
+            if (!reasoning_level.empty()) {
+                inputs.chat_template_kwargs["reasoning_effort"] = json(reasoning_level).dump();
+            }
+        }
+    }
+
+    if (!inputs.enable_thinking && !has_native_reasoning_level()) {
+        // Muse has no off mode. The caps layer aliases effort to strength, so
+        // clients that cannot hide their generic off choice get native low.
+        inputs.chat_template_kwargs["reasoning_effort"] = json("low").dump();
+    }
+
