 #include <cstring>
 #include <type_traits>
 
+// Maki 0.4.8's llama.cpp transport converts its named selectors to these
+// exact budgets for ROCmplete's advertised 16384-token output window. Recover
+// the name for templates with native effort/strength controls while retaining
+// the numeric sampler ceiling Maki requested.
+static std::string rocmplete_maki_reasoning_level(int budget) {
+    if (budget == 1638 || budget == 3276) {
+        return "low";
+    }
+    if (budget == 6553) {
+        return "medium";
+    }
+    if (budget == 9830) {
+        return "high";
+    }
+    if (budget == 13107 || budget == 16384) {
+        return "xhigh";
+    }
+    return "";
+}
+
+// Qwen3.8 was trained with distinct sampling policies for thinking and
+// non-thinking requests. Apply those policies as server defaults so every
+// OpenAI-compatible client gets the same mode-correct behavior without
+// duplicating the tuple in its own configuration.
+static void rocmplete_apply_qwen38_sampling_defaults(
+        json & llama_params,
+        const json & body,
+        bool enable_thinking) {
+    const auto set_default = [&llama_params, &body](const char * name, const json & value) {
+        const auto it = body.find(name);
+        if (it == body.end() || it->is_null()) {
+            llama_params[name] = value;
+        }
+    };
+
+    set_default("temperature",      enable_thinking ? 1.0  : 0.7);
+    set_default("top_p",            enable_thinking ? 0.95 : 0.8);
+    set_default("top_k",            20);
+    set_default("min_p",            0.0);
+    set_default("presence_penalty", enable_thinking ? 0.0  : 1.5);
+    set_default("repeat_penalty",   1.0);
+}
+
 json format_error_response(const std::string & message, const enum error_type type) {
     std::string type_str;
     int code = 500;
@@ -1278,9 +1321,17 @@ json oaicompat_chat_params_parse(
     // merge the template args provided from command line with the args provided in the user request
     auto chat_template_kwargs_object = json_value(body, "chat_template_kwargs", json::object());
     inputs.chat_template_kwargs = opt.chat_template_kwargs;
+    const auto rocmplete_sampling_profile = opt.chat_template_kwargs.find(
+        "rocmplete_sampling_profile");
+    const bool rocmplete_qwen38_sampling =
+        rocmplete_sampling_profile != opt.chat_template_kwargs.end() &&
+        rocmplete_sampling_profile->second == json("qwen3.8").dump();
     for (const auto & item : chat_template_kwargs_object.items()) {
         inputs.chat_template_kwargs[item.key()] = item.value().dump();
     }
+    // This namespaced startup marker is server policy, not a model template
+    // input. Do not expose it to Jinja or let a request spoof another policy.
+    inputs.chat_template_kwargs.erase("rocmplete_sampling_profile");
 
     // parse the "enable_thinking" kwarg to override the default value
     auto enable_thinking_kwarg = json_value(inputs.chat_template_kwargs, "enable_thinking", std::string(""));
@@ -1303,6 +1354,35 @@ json oaicompat_chat_params_parse(
         }
     }
 
+    // Maki transports its named selectors as numeric budgets. Preserve that
+    // sampler ceiling while supplying one native label for the template caps
+    // layer to alias to either Qwen effort or Muse strength. Explicit native
+    // template kwargs win over this compatibility recovery.
+    const auto has_native_reasoning_level = [&inputs]() {
+        return inputs.chat_template_kwargs.find("reasoning_effort") !=
+                   inputs.chat_template_kwargs.end() ||
+               inputs.chat_template_kwargs.find("reasoning_strength") !=
+                   inputs.chat_template_kwargs.end();
+    };
+    if (!body.contains("reasoning_effort") &&
+        body.contains("thinking_budget_tokens")) {
+        const int thinking_budget = json_value(body, "thinking_budget_tokens", -1);
+        if (thinking_budget == 0) {
+            inputs.enable_thinking = false;
+        } else if (thinking_budget > 0 && !has_native_reasoning_level()) {
+            const auto reasoning_level = rocmplete_maki_reasoning_level(thinking_budget);
+            if (!reasoning_level.empty()) {
+                inputs.chat_template_kwargs["reasoning_effort"] = json(reasoning_level).dump();
+            }
+        }
+    }
+
+    if (!inputs.enable_thinking && !has_native_reasoning_level()) {
+        // Muse has no off mode. The caps layer aliases effort to strength, so
+        // clients that cannot hide their generic off choice get native low.
+        inputs.chat_template_kwargs["reasoning_effort"] = json("low").dump();
+    }
+
     inputs.force_pure_content = opt.force_pure_content;
 
     // Apply chat template to the list of messages
@@ -1370,6 +1450,11 @@ json oaicompat_chat_params_parse(
         }
     }
 
