{{- bos_token }}
{%- for message in messages %}
  {%- if message["role"] == "user" %}
    {%- if message["content"] is not string %}
      {{- raise_exception("TranslateGemma expects user content as a string") }}
    {%- endif %}
    {{- "<start_of_turn>user\n" }}
    {{- message["content"] | trim }}
    {{- "<end_of_turn>\n" }}
  {%- elif message["role"] == "assistant" %}
    {%- if message["content"] is not string %}
      {{- raise_exception("TranslateGemma expects assistant content as a string") }}
    {%- endif %}
    {{- "<start_of_turn>model\n" }}
    {{- message["content"] | trim }}
    {{- "<end_of_turn>\n" }}
  {%- else %}
    {{- raise_exception("TranslateGemma supports only user and assistant roles") }}
  {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
  {{- "<start_of_turn>model\n" }}
{%- endif %}
